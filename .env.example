# Copy this file to .env and fill in your real values.
# .env is ignored by Git and should never be committed.

# --- OpenAI API ---
# Required for image analysis. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-key-here"

# --- PDF Export ---
# Set to "false" to disable PDF export and avoid loading fpdf2.
ENABLE_PDF_EXPORT="true"

# --- Progress Tracking ---
# Keep "false" until the legal/privacy gate is cleared.
ENABLE_PROGRESS_TRACKING="false"

# Optional encryption key for encrypted SQLite snapshot storage.
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORAGE_ENCRYPTION_KEY=""

# Optional SQLite database path for persistent snapshot storage.
# Leave unset to use the in-memory backend.
# SNAPSHOT_STORAGE_PATH="data/snapshots.db"

# --- Feedback Email (optional) ---
# Configure SMTP to send feedback emails from the Feedback page.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USE_TLS="true"
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM="support@corpusanalytica.com"
SMTP_TO="support@corpusanalytica.com"

# --- GitHub Integration (optional) ---
# Used for one-click "Report a bug" links on the Feedback page.
GITHUB_REPO_URL="https://github.com/aizech/corpus-analyzer"
